# ==========================================
# New Rahad Hosiery & Garments - Backend Env
# ==========================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-change-me-for-production-generate-a-strong-random-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave empty or set to sqlite:///db.sqlite3 for local SQLite development.
# For PostgreSQL (Neon/Supabase/Hostinger), provide the full URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# CORS Configuration (Next.js Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media Storage Mode: "local" (default) or "cloudinary"
MEDIA_STORAGE=local

# Cloudinary Storage Configuration (Required if MEDIA_STORAGE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
